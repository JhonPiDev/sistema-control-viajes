# ==========================================================
# Variables de entorno - Sistema de Control de Viajes
# Copia este archivo a ".env" en la raíz antes de levantar Docker
# ==========================================================

# ---- PostgreSQL (un solo servidor, dos bases de datos lógicas) ----
POSTGRES_USER=viajes_admin
POSTGRES_PASSWORD=viajes_password_seguro
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_TRIPS=trips_db
POSTGRES_DB_OPERATIONS=operations_db

DATABASE_URL_TRIPS=postgresql://viajes_admin:viajes_password_seguro@postgres:5432/trips_db?schema=public
DATABASE_URL_OPERATIONS=postgresql://viajes_admin:viajes_password_seguro@postgres:5432/operations_db?schema=public

# ---- JWT (compartido entre api-gateway y trips-service) ----
JWT_SECRET=cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# ---- Clave compartida entre api-gateway, trips-service y
# operations-service. Los microservicios exponen una API HTTP interna
# (ya no TCP puro) protegida con esta clave: cualquier request sin este
# header exacto (x-internal-key) se rechaza. Cambiala por un valor largo
# y aleatorio en producción; debe ser IGUAL en los 3 servicios.
INTERNAL_API_KEY=cambia-esta-clave-interna-en-produccion

# ---- Puertos HTTP internos de los microservicios (red interna docker) ----
TRIPS_SERVICE_PORT=3001
OPERATIONS_SERVICE_PORT=3002

# ---- API Gateway ----
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:8100

# Días que se conserva un viaje FINALIZADO antes de que la limpieza
# automática del gateway lo borre (junto con sus pasajeros, paradas,
# gastos y novedades). Los viajes pendientes o en curso nunca se tocan.
# Opcional: si no se define, el valor por defecto es 90.
TRIP_RETENTION_DAYS=90

# ---- Frontend (Ionic) ----
# URL pública del API Gateway que consumirá el frontend
API_URL=http://localhost:3000/api
